# --------------------
# Global Ignores
# --------------------
# Dependency directories
node_modules/
**/node_modules
.npm
.yarn

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log
lerna-debug.log
.pnpm-debug.log*

# OS specific files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.production.local
.env.*

# Backup files
*.bak
*.swp

# --------------------
# Next.js / Frontend Ignores
# --------------------
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/

# Vercel deployment files
.vercel

# Local TypeScript cache for Next.js
.tsbuildinfo

# --------------------
# Fastify / Backend Ignores
# --------------------
/backend/dist/          # Compiled output directory
/backend/coverage/
/backend/*.tsbuildinfo

# --------------------
# IDE & Editor Ignores (VS Code is common)
# --------------------
.vscode/
.idea/